# ── 前端运行时配置 ──────────────────────────────────
# 后端 API 地址：Netlify 同源部署时留空（/api/* 走 Netlify Functions）。
# 本地开发推荐使用 `netlify dev`，同样同源，留空即可。
NUXT_PUBLIC_API_BASE_URL=
NUXT_PUBLIC_SITE_DOMAIN=example.com
# GitHub OAuth 客户端 ID（公开值，配合后端 GITHUB_CLIENT_SECRET）
NUXT_PUBLIC_GITHUB_CLIENT_ID=

# ── 后端（Netlify Functions）配置 ────────────────────
# JWT 签发密钥，务必修改为随机长字符串（生产环境必须设置）
JWT_SECRET=change-me-to-a-long-random-secret

# GitHub OAuth 登录：在 https://github.com/settings/developers 注册 OAuth App，
# Authorization callback URL 填 <站点域名>/login
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=

# 首次部署时自动创建的管理员账号
ADMIN_INITIAL_EMAIL=admin@example.com
ADMIN_INITIAL_PASSWORD=admin123456

# 注册/找回密码的邮件验证码校验：
#   true  = 任意 6 位数字验证码即可（无邮件服务时便于测试）
#   false = 严格校验服务端下发的 6 位验证码（需接入邮件发送，如 Resend/SendGrid）
BYPASS_EMAIL_CODE=true
